{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "brasileiroscatolicosusa",
	"main": "worker/index.ts",
	"compatibility_date": "2026-08-17",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"html_handling": "drop-trailing-slash",
		"not_found_handling": "single-page-application",
		"run_worker_first": true
	},
	"observability": {
		"enabled": true
	},
	"workers_dev": true,
	"routes": [
		{
			"pattern": "brasileiroscatolicosusa.org",
			"custom_domain": true
		},
		{
			"pattern": "www.brasileiroscatolicosusa.org",
			"custom_domain": true
		}
	],
	"upload_source_maps": true,
	"vars": {
		"TURNSTILE_SITE_KEY": "0x4AAAAAAES8mfiaIh_2lxwC",
		"CARTO_API_KEY": "cb1_2qce_1_822b21356847b56f0051ce12"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "brasileiroscatolicosusa",
			"database_id": "41dd3e89-698b-46ea-96df-43d764f1211a",
			"preview_database_id": "41dd3e89-698b-46ea-96df-43d764f1211a",
			"migrations_dir": "migrations"
		}
	]
}
